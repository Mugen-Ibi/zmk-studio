  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mugen-Ibi/zmk-studio.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.2"
