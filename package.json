{
  "name": "zmk-studio",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "generate-data": "node scripts/generate-release-data.js",
    "dev": "npm run generate-data && vite",
    "build": "npm run generate-data && npm run typecheck && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "pretest": "npm run generate-data",
    "pretypecheck": "npm run generate-data",
    "prebuild-storybook": "npm run generate-data"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
