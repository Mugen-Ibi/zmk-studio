    "emittery": "^1.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.445.0",
    "react": "^18.2.0",
    "react-aria-components": "^1.4.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/w3c-web-serial": "^1.0.6",
    "@types/web-bluetooth": "^0.0.20",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "prettier": "3.3.2",
    "run-script-os": "^1.1.6",
    "storybook": "^10.6.6",
    "tailwindcss": "^3.4.4",
    "tailwindcss-react-aria-components": "^1.1.3",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^5.1.0"
